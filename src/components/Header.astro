---
import Icon from "./Icon.astro";
import { site } from "../data/site";

const nav = [
  { href: "#work", label: "Work" },
  { href: "#about", label: "About" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-40 border-b border-line/60 bg-bg/75 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="#top" class="font-mono text-sm font-semibold tracking-tight" aria-label={`${site.name}, back to top`}>
      kehinde<span class="text-accent">.</span>ojapa
    </a>

    <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden items-center gap-1 sm:flex">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-md px-3 py-2 text-sm text-muted transition-colors hover:bg-card-hover hover:text-fg"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-md text-muted transition-colors hover:bg-card-hover hover:text-fg"
        aria-label="Toggle colour theme"
      >
        <Icon name="sun" class="hidden size-4 dark:block" />
        <Icon name="moon" class="size-4 dark:hidden" />
      </button>
      <a
        href={site.cv}
        download
        class="inline-flex h-9 items-center gap-1.5 rounded-md border border-line px-3 text-sm font-medium transition-colors hover:bg-card-hover"
      >
        <Icon name="download" class="size-3.5" />
        CV
      </a>
    </nav>
  </div>
</header>
