---
import Icon from "./Icon.astro";
import type { Project, LinkKind } from "../data/projects";

interface Props {
  project: Project;
  size?: "sm" | "md";
}
const { project, size = "md" } = Astro.props;

const meta: Record<LinkKind, { label: string; icon: "apple" | "play" | "globe" | "code" }> = {
  appstore: { label: "App Store", icon: "apple" },
  playstore: { label: "Google Play", icon: "play" },
  live: { label: "Live site", icon: "globe" },
  code: { label: "Source", icon: "code" },
};

const base =
  size === "md"
    ? "h-9 gap-2 px-3.5 text-sm"
    : "h-8 gap-1.5 px-2.5 text-xs";
---

<ul class="flex flex-wrap gap-2">
  {
    project.links.map((link) => (
      <li>
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            "inline-flex items-center rounded-md border border-line bg-bg font-medium transition-colors hover:border-accent/50 hover:text-accent",
            base,
          ]}
        >
          <Icon name={meta[link.kind].icon} class="size-3.5" />
          {meta[link.kind].label}
          <span class="sr-only">for {project.title} (opens in a new tab)</span>
        </a>
      </li>
    ))
  }
</ul>
